<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.servoy</groupId>
	<artifactId>sj.jsonschemavalidation.parent</artifactId>
	<version>3.0.0</version>
	<packaging>pom</packaging>

	<properties>
		<tycho-version>4.0.13</tycho-version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>21</maven.compiler.release>
	</properties>

	<modules>
		<module>sj.jsonschemavalidation</module>
		<module>sj.jsonschemavalidation.tests</module>
	</modules>

	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-maven-plugin</artifactId>
				<version>${tycho-version}</version>
				<extensions>true</extensions>
			</plugin>

			<!-- Resolve dependencies against the .target file: the plain Eclipse
			     update site plus the json-schema-validator (and Jackson) pulled
			     straight from Maven Central. Shared by the plug-in and its tests. -->
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>target-platform-configuration</artifactId>
				<version>${tycho-version}</version>
				<configuration>
					<target>
						<file>${maven.multiModuleProjectDirectory}/sj.jsonschemavalidation/sj.jsonschemavalidation.target</file>
					</target>
					<executionEnvironment>JavaSE-21</executionEnvironment>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<distributionManagement>
		<repository>
			<id>my-s3-release-repo</id>
			<url>file://C:/m2-repo/</url>
		</repository>
	</distributionManagement>

	<licenses>
		<license>
			<name>Mozilla Public License Version 2.0</name>
			<url>http://www.mozilla.org/MPL/2.0/index.txt</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>sj</id>
			<name>sj</name>
		</developer>
	</developers>

</project>
